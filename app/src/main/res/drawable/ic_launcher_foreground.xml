<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground.

  The iOS Exchange keyhole — a cream-coloured circle on top with a
  straight-sided funnel/trapezoid widening as it falls below. Drawn
  as a single continuous path so the circle and the trapezoid share
  a tangent (no visible seam where they join).

  The 108x108 viewport is split by the launcher into an outer mask
  area and an inner 66x66 "safe zone". This shape sits centred and
  fits inside the safe zone with a little breathing room above and
  below so the launcher's circular/squircle masks don't clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      Keyhole proportions:
        circle  centre (54, 46), radius 12
        funnel  top half-width 9 at y ≈ 53.94 (tangent to the circle),
                bottom half-width 13 at y = 74
      This sits well within the inner 66-dp safe zone so launcher masks
      (square, circle, squircle, teardrop) leave breathing room around
      every edge.
    -->
    <path
        android:fillColor="#ECE3CC"
        android:pathData="M45,53.94 A12,12 0 1 1 63,53.94 L67,74 L41,74 Z" />
</vector>
