<!--
  Themed-icon monochrome layer (Android 13+).

  Same keyhole silhouette as the foreground but rendered as a single
  flat colour: the launcher recolours this to match the user's themed-
  icon palette. Adaptive-icon descriptors reference this via the
  `<monochrome>` tag in `mipmap-anydpi/ic_launcher*.xml`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
