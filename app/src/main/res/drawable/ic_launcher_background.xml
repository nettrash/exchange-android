<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background.

  Matches the iOS app icon: a near-vertical linear gradient from a
  slightly brighter indigo at the top to a darker indigo at the bottom.
  Adaptive icons render against a 108x108 dp viewport; the launcher
  then applies its own mask (square, circle, squircle, …) so the
  background fills edge-to-edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0.0" android:color="#2A1F70" />
                <item android:offset="1.0" android:color="#15104A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
