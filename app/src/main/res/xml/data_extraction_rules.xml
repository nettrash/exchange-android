<?xml version="1.0" encoding="utf-8"?>
<!-- Block device-to-device transfer and cloud backup of every app
     data domain. The user moves identity via passphrase export / QR
     transfer instead, so secrets stay end-to-end encrypted in transit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
