<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup is disabled at the application level. This file remains
     so existing references resolve, but excludes everything. We never
     want the identity blob or recipient database to leave the device
     via any Google-managed channel. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
